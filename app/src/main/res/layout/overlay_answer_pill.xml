<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pillRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_answer_pill"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/pillLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/answer_pill_label"
        android:textColor="@color/brand_light"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/pillAnswer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:maxWidth="196dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />
</LinearLayout>
